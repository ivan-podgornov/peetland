{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "lib": ["ESNext"],
    "target": "esnext",
    "verbatimModuleSyntax": false,
    "paths": {
      "@peetland/actor-command": ["../../core/actor-command/src/index.ts"],
      "@peetland/animation-manager": ["../../core/animation-manager/src/index.ts"],
      "@peetland/game": ["../../core/game/src/index.ts"],
      "@peetland/inventory": ["../../core/inventory/src/index.ts"],
      "@peetland/world": ["../../core/world/src/index.ts"],
      "@peetland/gta-sa": ["../gta-sa/src/index.ts"],
      "@peetland/moonloader": ["../moonloader/src/index.ts"],
      "vkeys": ["../moonloader/src/vkeys.ts"],
      "@peetland/events": ["../../toolkit/events/src/index.ts"],
      "@peetland/geometry": ["../../toolkit/geometry/src/index.ts"],
      "@peetland/htn": ["../../toolkit/htn/src/index.ts"],
      "@peetland/repository": ["../../toolkit/repository/src/index.ts"],
      "@peetland/timings": ["../../toolkit/timings/src/index.ts"]
    }
  },
  "tstl": {
    "luaBundle": "./dist/peetland.lua",
    "luaBundleEntry": "./src/main.ts",
    "luaTarget": "JIT",
    "noImplicitSelf": true,
    "noResolvePaths": ["vkeys"]
  },
  "include": ["./_G.d.ts", "./src/**/*.ts"]
}
